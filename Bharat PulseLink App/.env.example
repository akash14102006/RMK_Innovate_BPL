# Bharat PulseLink Mobile App (Expo) — Local Development Environment Template
# Copy to .env for local client development.
# Only variables prefixed with EXPO_PUBLIC_ are accessible to the frontend.

# ── Descope Authentication ───────────────────────────────────────────────────
# Public Descope Project ID (safe for client-side embedding)
EXPO_PUBLIC_DESCOPE_PROJECT_ID=P3I9QWPyM9U9U4hEa9u5613xRwbf

# ── Backend API Gateway ──────────────────────────────────────────────────────
# Local development API endpoint (use local IP for physical Android/iOS testing)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# ── Development Auth Bypass ──────────────────────────────────────────────────
# Set to 'true' for local development to bypass external Descope / MiniMoth calls.
# Accepts ONLY WhatsApp code 123456. In production builds, this is strictly false.
EXPO_PUBLIC_DEV_AUTH_BYPASS=false

