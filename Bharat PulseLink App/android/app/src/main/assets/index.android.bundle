bc1 \u0b9a\u0bbf\u0b95\u0bbf\u0b9a\u0bcd\u0b9a\u0bc8 \u0baa\u0bc6\u0bb1\u0bcd\u0bb1\u0bbe\u0bb2\u0bc1\u0bae\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bc1\u0b95\u0bbe\u0ba4\u0bbe\u0bb0\u0baa\u0bcd \u0baa\u0baf\u0ba3\u0ba4\u0bcd\u0ba4\u0bc8 \u0b87\u0ba3\u0bc8\u0baa\u0bcd\u0baa\u0bbf\u0bb2\u0bcd \u0bb5\u0bc8\u0ba4\u0bcd\u0ba4\u0bbf\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.',accessibilityHero:'\u0b9a\u0bc1\u0b95\u0bbe\u0ba4\u0bbe\u0bb0 \u0b85\u0b9f\u0bc8\u0baf\u0bbe\u0bb3\u0ba4\u0bcd\u0ba4\u0bc8 \u0bb5\u0bbf\u0bb3\u0b95\u0bcd\u0b95\u0bc1\u0bae\u0bcd \u0baa\u0b9f\u0bae\u0bcd.'},screen2:{eyebrow:'\u0ba8\u0bc6\u0b9f\u0bcd\u0bb5\u0bca\u0bb0\u0bcd\u0b95\u0bcd \u0b85\u0ba3\u0bc1\u0b95\u0bb2\u0bcd',title:'\u0b85\u0bb0\u0bc1\u0b95\u0bbf\u0bb2\u0bc1\u0bb3\u0bcd\u0bb3 \u0bae\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0ba9\u0bc8\u0baf\u0bc8\u0b95\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bb1\u0bbf\u0baf\u0bb5\u0bc1\u0bae\u0bcd.',description:'\u0b87\u0ba8\u0bcd\u0ba4\u0bbf\u0baf\u0bbe \u0bae\u0bc1\u0bb4\u0bc1\u0bb5\u0ba4\u0bc1\u0bae\u0bcd \u0b89\u0bb3\u0bcd\u0bb3 \u0bae\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5\u0bae\u0ba9\u0bc8\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b86\u0baf\u0bcd\u0bb5\u0b95\u0b99\u0bcd\u0b95\u0bb3\u0bc8 \u0b89\u0b9f\u0ba9\u0b9f\u0bbf\u0baf\u0bbe\u0b95\u0b95\u0bcd \u0b95\u0ba3\u0bcd\u0b9f\u0bb1\u0bbf\u0baf\u0bb5\u0bc1\u0bae\u0bcd.',accessibilityHero:'\u0b9a\u0bc1\u0b95\u0bbe\u0ba4\u0bbe\u0bb0 \u0ba8\u0bc6\u0b9f\u0bcd\u0bb5\u0bca\u0bb0\u0bcd\u0b95\u0bcd \u0ba4\u0bc7\u0b9f\u0bb2\u0bbf\u0ba9\u0bcd \u0baa\u0b9f\u0bae\u0bcd.'},screen3:{eyebrow:'\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bc1 \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b9a\u0bae\u0bcd\u0bae\u0ba4\u0bae\u0bcd',title:'\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0baa\u0bcd\u0baa\u0bbe\u0b95\u0baa\u0bcd \u0baa\u0b95\u0bbf\u0bb0\u0bb5\u0bc1\u0bae\u0bcd. \u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bbf\u0bb2\u0bcd \u0b87\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bb3\u0bcd.',description:'\u0bae\u0bc1\u0bb4\u0bc1\u0bae\u0bc8\u0baf\u0bbe\u0ba9 \u0ba4\u0ba9\u0bbf\u0baf\u0bc1\u0bb0\u0bbf\u0bae\u0bc8\u0b95\u0bcd \u0b95\u0b9f\u0bcd\u0b9f\u0bc1\u0baa\u0bcd\u0baa\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0b9f\u0ba9\u0bcd \u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0ba4\u0bb1\u0bcd\u0b95\u0bbe\u0bb2\u0bbf\u0b95 \u0b85\u0ba3\u0bc1\u0b95\u0bb2\u0bc8 \u0bb5\u0bb4\u0b99\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd.',accessibilityHero:'\u0baa\u0bbe\u0ba4\u0bc1\u0b95\u0bbe\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b9a\u0bc1\u0b95\u0bbe\u0ba4\u0bbe\u0bb0 \u0b9a\u0bae\u0bcd\u0bae\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcd \u0baa\u0b9f\u0bae\u0bcd.'},screen4:{eyebrow:'\u0b92\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbf\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b9a\u0bc1\u0b95\u0bbe\u0ba4\u0bbe\u0bb0\u0bae\u0bcd',title:'\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bc1\u0b95\u0bbe\u0ba4\u0bbe\u0bb0\u0baa\u0bcd \u0baa\u0baf\u0ba3\u0bae\u0bcd, \u0b87\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f\u0ba4\u0bc1.',description:'\u0baa\u0ba4\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bae\u0bb0\u0bc1\u0ba4\u0bcd\u0ba4\u0bc1\u0bb5 \u0b85\u0bb1\u0bbf\u0b95\u0bcd\u0b95\u0bc8\u0b95\u0bb3\u0bc8 \u0b92\u0bb0\u0bc7 \u0b87\u0b9f\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b8e\u0bb3\u0bbf\u0ba4\u0bbe\u0b95 \u0b87\u0ba3\u0bc8\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd.',accessibilityHero:'\u0b92\u0bb0\u0bc1\u0b99\u0bcd\u0b95\u0bbf\u0ba3\u0bc8\u0ba8\u0bcd\u0ba4 \u0b9a\u0bc1\u0b95\u0bbe\u0ba4\u0bbe\u0bb0 \u0b85\u0bae\u0bc8\u0baa\u0bcd\u0baa\u0bbf\u0ba9\u0bcd \u0baa\u0b9f\u0bae\u0bcd.'}},languageSelection:{eyebrow:'\u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bae\u0bbe\u0ba9 \u0bae\u0bca\u0bb4\u0bbf',title:'\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0bae\u0bca\u0bb4\u0bbf\u0baf\u0bc8\u0ba4\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd',subtitle:'\u0b89\u0b99\u0bcd\u0b95\u0bb3\u0bcd \u0b9a\u0bc1\u0b95\u0bbe\u0ba4\u0bbe\u0bb0\u0baa\u0bcd \u0baa\u0baf\u0ba3\u0ba4\u0bcd\u0ba4\u0bbf\u0bb1\u0bcd\u0b95\u0bc1 \u0bb5\u0bbf\u0bb0\u0bc1\u0baa\u0bcd\u0baa\u0bae\u0bbe\u0ba9 \u0bae\u0bca\u0bb4\u0bbf\u0baf\u0bc8\u0ba4\u0bcd \u0ba4\u0bc7\u0bb0\u0bcd\u0ba8\u0bcd\u0ba4\u0bc6\u0b9f\u0bc1\u0b95\u0bcd\u0b95\u0bb5\u0bc1\u0bae\u0bcd',continue:'\u0ba4\u0bca\u0b9f\u0bb0\u0bb5\u0bc1\u0bae\u0bcd',accessibilityHero:'\u0bae\u0bca\u0bb4\u0bbf \u0baa\u0bc6\u0baf\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bc8\u0b95\u0bcd \u0b95\u0bbe\u0b9f\u0bcd\u0b9f\u0bc1\u0bae\u0bcd \u0baa\u0b9f\u0bae\u0bcd.'},auth:{login:'\u0b89\u0bb3\u0bcd\u0ba8\u0bc1\u0bb4\u0bc8\u0b95'}},te:{common:{appName:'\u0c2d\u0c3e\u0c30\u0c24\u0c4d \u0c2a\u0c32\u0c4d\u0c38\u0c4d\u200c\u0c32\u0c3f\u0c02\u0c15\u0c4d',continue:'\u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',back:'\u0c35\u0c46\u0c28\u0c41\u0c15\u0c15\u0c41',skip:'\u0c26\u0c3e\u0c1f\u0c35\u0c47\u0c2f\u0c3f',getStarted:'\u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f'},onboarding:{common:{continue:'\u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',back:'\u0c35\u0c46\u0c28\u0c41\u0c15\u0c15\u0c41',skip:'\u0c26\u0c3e\u0c1f\u0c35\u0c47\u0c2f\u0c3f',getStarted:'\u0c2a\u0c4d\u0c30\u0c3e\u0c30\u0c02\u0c2d\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f'},screen1:{eyebrow:'\u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41',title:'\u0c2e\u0c40 \u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f\u0c02. \u0c2e\u0c40 \u0c28\u0c3f\u0c30\u0c02\u0c24\u0c30\u0c24.',description:'\u0c2e\u0c40\u0c30\u0c41 \u0c0e\u0c15\u0c4d\u0c15\u0c21 \u0c1a\u0c3f\u0c15\u0c3f\u0c24\u0c4d\u0c38 \u0c2a\u0c4a\u0c02\u0c26\u0c3f\u0c28\u0c3e \u0c2e\u0c40 \u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f \u0c2a\u0c4d\u0c30\u0c2f\u0c3e\u0c23\u0c3e\u0c28\u0c4d\u0c28\u0c3f \u0c05\u0c28\u0c41\u0c38\u0c02\u0c27\u0c3e\u0c28\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f.',accessibilityHero:'\u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f \u0c17\u0c41\u0c30\u0c4d\u0c24\u0c3f\u0c02\u0c2a\u0c41 \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c02.'},screen2:{eyebrow:'\u0c28\u0c46\u0c1f\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c15\u0c4d \u0c32\u0c2d\u0c4d\u0c2f\u0c24',title:'\u0c38\u0c2e\u0c40\u0c2a\u0c02\u0c32\u0c4b\u0c28\u0c3f \u0c38\u0c02\u0c30\u0c15\u0c4d\u0c37\u0c23\u0c28\u0c41 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c02\u0c21\u0c3f.',description:'\u0c2d\u0c3e\u0c30\u0c24\u0c26\u0c47\u0c36\u0c02 \u0c05\u0c02\u0c24\u0c1f\u0c3e \u0c06\u0c38\u0c41\u0c2a\u0c24\u0c4d\u0c30\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c32\u0c4d\u0c2f\u0c3e\u0c2c\u0c4d\u200c\u0c32\u0c28\u0c41 \u0c24\u0c15\u0c4d\u0c37\u0c23\u0c2e\u0c47 \u0c15\u0c28\u0c41\u0c17\u0c4a\u0c28\u0c02\u0c21\u0c3f.',accessibilityHero:'\u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f \u0c28\u0c46\u0c1f\u0c4d\u200c\u0c35\u0c30\u0c4d\u0c15\u0c4d \u0c36\u0c4b\u0c27\u0c28 \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c02.'},screen3:{eyebrow:'\u0c2d\u0c26\u0c4d\u0c30\u0c24 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f',title:'\u0c38\u0c41\u0c30\u0c15\u0c4d\u0c37\u0c3f\u0c24\u0c02\u0c17\u0c3e \u0c2d\u0c3e\u0c17\u0c38\u0c4d\u0c35\u0c3e\u0c2e\u0c4d\u0c2f\u0c02 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.',description:'\u0c2a\u0c42\u0c30\u0c4d\u0c24\u0c3f \u0c17\u0c4b\u0c2a\u0c4d\u0c2f\u0c24\u0c3e \u0c28\u0c3f\u0c2f\u0c02\u0c24\u0c4d\u0c30\u0c23\u0c24\u0c4b \u0c2e\u0c40 \u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c15\u0c41 \u0c2a\u0c30\u0c3f\u0c2e\u0c3f\u0c24 \u0c38\u0c2e\u0c2f\u0c02 \u0c2a\u0c4d\u0c30\u0c3e\u0c2a\u0c4d\u0c2f\u0c24\u0c28\u0c41 \u0c2e\u0c02\u0c1c\u0c42\u0c30\u0c41 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.',accessibilityHero:'\u0c0e\u0c28\u0c4d\u200c\u0c15\u0c4d\u0c30\u0c3f\u0c2a\u0c4d\u0c1f\u0c46\u0c21\u0c4d \u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f \u0c38\u0c2e\u0c4d\u0c2e\u0c24\u0c3f \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c02.'},screen4:{eyebrow:'\u0c0f\u0c15\u0c40\u0c15\u0c43\u0c24 \u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f\u0c02',title:'\u0c2e\u0c40 \u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f \u0c2a\u0c4d\u0c30\u0c2f\u0c3e\u0c23\u0c02, \u0c05\u0c28\u0c41\u0c38\u0c02\u0c27\u0c3e\u0c28\u0c3f\u0c02\u0c1a\u0c2c\u0c21\u0c3f\u0c02\u0c26\u0c3f.',description:'\u0c30\u0c3f\u0c15\u0c3e\u0c30\u0c4d\u0c21\u0c41\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c28\u0c3f\u0c35\u0c47\u0c26\u0c3f\u0c15\u0c32\u0c28\u0c41 \u0c12\u0c15\u0c47 \u0c1a\u0c4b\u0c1f \u0c38\u0c41\u0c32\u0c2d\u0c02\u0c17\u0c3e \u0c1c\u0c24 \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f.',accessibilityHero:'\u0c0f\u0c15\u0c40\u0c15\u0c43\u0c24 \u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f \u0c35\u0c4d\u0c2f\u0c35\u0c38\u0c4d\u0c25 \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c02.'}},languageSelection:{eyebrow:'\u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f \u0c2d\u0c3e\u0c37',title:'\u0c2e\u0c40 \u0c2d\u0c3e\u0c37\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f',subtitle:'\u0c2e\u0c40 \u0c06\u0c30\u0c4b\u0c17\u0c4d\u0c2f \u0c38\u0c02\u0c30\u0c15\u0c4d\u0c37\u0c23 \u0c2a\u0c4d\u0c30\u0c2f\u0c3e\u0c23\u0c02 \u0c15\u0c4b\u0c38\u0c02 \u0c2e\u0c40 \u0c2a\u0c4d\u0c30\u0c3e\u0c27\u0c3e\u0c28\u0c4d\u0c2f \u0c2d\u0c3e\u0c37\u0c28\u0c41 \u0c0e\u0c02\u0c1a\u0c41\u0c15\u0c4b\u0c02\u0c21\u0c3f',continue:'\u0c15\u0c4a\u0c28\u0c38\u0c3e\u0c17\u0c3f\u0c02\u0c1a\u0c02\u0c21\u0c3f',accessibilityHero:'\u0c2d\u0c3e\u0c37\u0c3e \u0c05\u0c28\u0c41\u0c35\u0c3e\u0c26 \u0c1a\u0c3f\u0c24\u0c4d\u0c30\u0c02.'},auth:{login:'\u0c32\u0c3e\u0c17\u0c3f\u0c28\u0c4d \u0c1a\u0c47\u0c2f\u0c02\u0c21\u0c3f'}},bn:{common:{appName:'\u09ad\u09be\u09b0\u09a4 \u09aa\u09be\u09b2\u09b8\u09b2\u09bf\u0982\u0995',continue:'\u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8',back:'\u09ab\u09bf\u09b0\u09c7 \u09af\u09be\u09a8',skip:'\u098f\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8',getStarted:'\u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8'},onboarding:{common:{continue:'\u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8',back:'\u09ab\u09bf\u09b0\u09c7 \u09af\u09be\u09a8',skip:'\u098f\u09a1\u09bc\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8',getStarted:'\u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c1\u09a8'},screen1:{eyebrow:'\u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af \u09aa\u09b0\u09bf\u099a\u09af\u09bc',title:'\u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09a7\u09be\u09b0\u09be\u09ac\u09be\u09b9\u09bf\u0995\u09a4\u09be\u0964',description:'\u0986\u09aa\u09a8\u09bf \u09af\u09c7\u0996\u09be\u09a8\u09c7\u0987 \u09af\u09be\u09a8 \u09a8\u09be \u0995\u09c7\u09a8 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af \u09af\u09be\u09a4\u09cd\u09b0\u09be \u09af\u09c1\u0995\u09cd\u09a4 \u09b0\u09be\u0996\u09c1\u09a8\u0964',accessibilityHero:'\u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af \u09aa\u09b0\u09bf\u099a\u09af\u09bc\u09c7\u09b0 \u099b\u09ac\u09bf\u0964'},screen2:{eyebrow:'\u09a8\u09c7\u099f\u0993\u09af\u09bc\u09be\u09b0\u09cd\u0995 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8',title:'\u09a8\u09bf\u0995\u099f\u09b8\u09cd\u09a5 \u09b8\u09cd\u09ac\u09be\u09b8\u09cd\u09a5\u09cd\u09af\u09b8\u09c7\u09ac\u09be \u0996\u09c1\u0981\u099c\u09c1\u09a8\u0964',description:'\u09ad\u09be\u09b0\u09a4 \u099c\u09c1\u09a1\u09bc\u09c7 \u09b9\u09be\u09b8\u09aa\u09be\u09a4\u09be\u09b2 \u098f\u09ac\u0982 \u09b2\u09cd\u09af\u09be\u09ac\u0997\u09c1\u09b2\u09bf \u09a4\u09be\u09a4\u09cd\u0995\u09cd\u09b7\u09a3\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09c1\u09a8\u0964',accessibilityHero:'\u09a8\u09c7\u099f\u0993\u09af\u09bc\u09be\u09b0\u09cd\u0995 \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8\u09c7\u09b0 \u099b\u09ac\u09bf\u0964'},screen3:{eyebrow:'\u09a8\u09bf\u09b0\u09be\u09aa\u09a4\u09cd\u09a4\u09be \u0993 \u09b8\u09ae\u09cd\u09ae\u09a4\u09bf',title:'\u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09bf\u09a4\u09ad\u