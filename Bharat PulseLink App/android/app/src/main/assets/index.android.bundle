8\u09be\u09b0 \u09aa\u099b\u09a8\u09cd\u09a6\u09c7\u09b0 \u09ad\u09be\u09b7\u09be \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8',continue:'\u098f\u0997\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09a8',accessibilityHero:'\u0985\u09a8\u09c1\u09ac\u09be\u09a6 \u099a\u09bf\u09a4\u09cd\u09b0\u09bf\u09a4 \u0985\u09cd\u09af\u09be\u09a8\u09bf\u09ae\u09c7\u09b6\u09a8\u0964'},auth:{login:'\u09b2\u0997 \u0987\u09a8 \u0995\u09b0\u09c1\u09a8'}},mr:{common:{appName:'\u092d\u093e\u0930\u0924 \u092a\u0932\u094d\u0938\u0932\u093f\u0902\u0915',continue:'\u092a\u0941\u0922\u0947 \u091c\u093e',back:'\u092e\u093e\u0917\u0947',skip:'\u0935\u0917\u0933\u093e',getStarted:'\u0936\u0941\u0930\u0942 \u0915\u0930\u093e'},onboarding:{common:{continue:'\u092a\u0941\u0922\u0947 \u091c\u093e',back:'\u092e\u093e\u0917\u0947',skip:'\u0935\u0917\u0933\u093e',getStarted:'\u0936\u0941\u0930\u0942 \u0915\u0930\u093e'},screen1:{eyebrow:'\u0906\u0930\u094b\u0917\u094d\u092f \u0913\u0933\u0916',title:'\u0924\u0941\u092e\u091a\u0947 \u0906\u0930\u094b\u0917\u094d\u092f. \u0924\u0941\u092e\u091a\u0940 \u0938\u093e\u0924\u0924\u094d\u092f\u0924\u093e.',description:'\u0924\u0941\u092e\u094d\u0939\u0940 \u0915\u0941\u0920\u0947\u0939\u0940 \u0909\u092a\u091a\u093e\u0930 \u0918\u0947\u0924\u0932\u0947 \u0924\u0930\u0940 \u0924\u0941\u092e\u091a\u093e \u0906\u0930\u094b\u0917\u094d\u092f \u092a\u094d\u0930\u0935\u093e\u0938 \u091c\u094b\u0921\u0932\u0947\u0932\u093e \u0920\u0947\u0935\u093e.',accessibilityHero:'\u0906\u0930\u094b\u0917\u094d\u092f \u0913\u0933\u0916\u0940\u091a\u0947 \u091a\u093f\u0924\u094d\u0930.'},screen2:{eyebrow:'\u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e',title:'\u091c\u0935\u0933\u091a\u0947 \u0906\u0930\u094b\u0917\u094d\u092f \u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u094b\u0927\u093e.',description:'\u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u092d\u093e\u0930\u0924\u093e\u0924\u0940\u0932 \u0930\u0941\u0917\u094d\u0923\u093e\u0932\u092f\u0947 \u0906\u0923\u093f \u092a\u094d\u0930\u092f\u094b\u0917\u0936\u093e\u0933\u093e \u0924\u094d\u0935\u0930\u093f\u0924 \u0936\u094b\u0927\u093e.',accessibilityHero:'\u0906\u0930\u094b\u0917\u094d\u092f \u0915\u0947\u0902\u0926\u094d\u0930 \u0936\u094b\u0927\u093e\u091a\u0947 \u091a\u093f\u0924\u094d\u0930.'},screen3:{eyebrow:'\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0906\u0923\u093f \u0938\u0941\u0930\u0915\u094d\u0937\u093e',title:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924\u092a\u0923\u0947 \u0936\u0947\u0905\u0930 \u0915\u0930\u093e. \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923\u093e\u0924 \u0930\u093e\u0939\u093e.',description:'\u092a\u0942\u0930\u094d\u0923 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u0947\u0938\u0939 \u0924\u0941\u092e\u091a\u094d\u092f\u093e \u0928\u094b\u0902\u0926\u0940\u0902\u091a\u093e \u092e\u0930\u094d\u092f\u093e\u0926\u093f\u0924 \u0915\u093e\u0932\u093e\u0935\u0927\u0940\u0938\u093e\u0920\u0940 \u092a\u094d\u0930\u0935\u0947\u0936 \u0926\u094d\u092f\u093e.',accessibilityHero:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u0902\u092e\u0924\u0940\u091a\u0947 \u091a\u093f\u0924\u094d\u0930.'},screen4:{eyebrow:'\u090f\u0915\u093e\u0924\u094d\u092e\u093f\u0915 \u0906\u0930\u094b\u0917\u094d\u092f \u0938\u0947\u0935\u093e',title:'\u0924\u0941\u092e\u091a\u093e \u0906\u0930\u094b\u0917\u094d\u092f \u092a\u094d\u0930\u0935\u093e\u0938, \u091c\u094b\u0921\u0932\u0947\u0932\u093e.',description:'\u0935\u0948\u0926\u094d\u092f\u0915\u0940\u092f \u0928\u094b\u0902\u0926\u0940 \u0906\u0923\u093f \u0905\u0939\u0935\u093e\u0932 \u090f\u0915\u093e\u091a \u0920\u093f\u0915\u093e\u0923\u0940 \u0938\u0939\u091c \u091c\u094b\u0921\u093e.',accessibilityHero:'\u090f\u0915\u093e\u0924\u094d\u092e\u093f\u0915 \u0906\u0930\u094b\u0917\u094d\u092f \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u0947\u091a\u0947 \u091a\u093f\u0924\u094d\u0930.'}},languageSelection:{eyebrow:'\u0928\u093f\u0935\u0921\u0932\u094