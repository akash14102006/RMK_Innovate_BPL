d\u0aaf \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0ab6\u0acb\u0aa7\u0acb.',description:'\u0aad\u0abe\u0ab0\u0aa4\u0aad\u0ab0\u0aae\u0abe\u0a82 \u0ab9\u0acb\u0ab8\u0acd\u0aaa\u0abf\u0a9f\u0ab2\u0acb \u0a85\u0aa8\u0ac7 \u0ab2\u0ac7\u0aac\u0acd\u0ab8 \u0aa4\u0abe\u0aa4\u0acd\u0a95\u0abe\u0ab2\u0abf\u0a95 \u0ab6\u0acb\u0aa7\u0acb.',accessibilityHero:'\u0aa8\u0ac7\u0a9f\u0ab5\u0ab0\u0acd\u0a95 \u0ab6\u0acb\u0aa7\u0aa8\u0ac1\u0a82 \u0a9a\u0abf\u0aa4\u0acd\u0ab0.'},screen3:{eyebrow:'\u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abe \u0a85\u0aa8\u0ac7 \u0ab8\u0a82\u0aae\u0aa4\u0abf',title:'\u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab6\u0ac7\u0ab0 \u0a95\u0ab0\u0acb. \u0aa8\u0abf\u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0aa3\u0aae\u0abe\u0a82 \u0ab0\u0ab9\u0acb.',description:'\u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a97\u0acb\u0aaa\u0aa8\u0ac0\u0aaf\u0aa4\u0abe \u0aa8\u0abf\u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0aa3 \u0ab8\u0abe\u0aa5\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0abe \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1\u0acd\u0ab8\u0aa8\u0ac0 \u0a8d\u0a95\u0acd\u0ab8\u0ac7\u0ab8 \u0a86\u0aaa\u0acb.',accessibilityHero:'\u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0ab8\u0a82\u0aae\u0aa4\u0abf\u0aa8\u0ac1\u0a82 \u0a9a\u0abf\u0aa4\u0acd\u0ab0.'},screen4:{eyebrow:'\u0a8f\u0a95\u0ac0\u0a95\u0ac3\u0aa4 \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0ab8\u0ac7\u0ab5\u0abe',title:'\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0aaf\u0abe\u0aa4\u0acd\u0ab0\u0abe, \u0a9c\u0acb\u0aa1\u0abe\u0aaf\u0ac7\u0ab2\u0ac0.',description:'\u0aa4\u0aae\u0abe\u0aae \u0ab0\u0ac7\u0a95\u0acb\u0ab0\u0acd\u0aa1\u0acd\u0ab8 \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0abf\u0ab8\u0acd\u0a95\u0acd\u0ab0\u0abf\u0aaa\u0acd\u0ab6\u0aa8\u0acd\u0ab8 \u0a8f\u0a95 \u0a9c \u0a9c\u0a97\u0acd\u0aaf\u0abe\u0a8f \u0ab8\u0ab0\u0ab3\u0aa4\u0abe\u0aa5\u0ac0 \u0a9c\u0acb\u0aa1\u0acb.',accessibilityHero:'\u0a8f\u0a95\u0ac0\u0a95\u0ac3\u0aa4 \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0ab5\u0acd\u0aaf\u0ab5\u0ab8\u0acd\u0aa5\u0abe\u0aa8\u0ac1\u0a82 \u0a9a\u0abf\u0aa4\u0acd\u0ab0.'}},languageSelection:{eyebrow:'\u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0\u0aa8\u0ac0 \u0aad\u0abe\u0ab7\u0abe',title:'\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aad\u0abe\u0ab7\u0abe \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb',subtitle:'\u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0ab8\u0a82\u0aad\u0abe\u0ab3 \u0aaf\u0abe\u0aa4\u0acd\u0ab0\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aa4\u0aae\u0abe\u0ab0\u0ac0 \u0aaa\u0ab8\u0a82\u0aa6\u0a97\u0ac0\u0aa8\u0ac0 \u0aad\u0abe\u0ab7\u0abe \u0aaa\u0ab8\u0a82\u0aa6 \u0a95\u0ab0\u0acb',continue:'\u0a86\u0a97\u0ab3 \u0ab5\u0aa7\u0acb',accessibilityHero:'\u0aad\u0abe\u0ab7\u0abe \u0aad\u0abe\u0ab7\u0abe\u0a82\u0aa4\u0ab0\u0aa8\u0ac1\u0a82 \u0a9a\u0abf\u0aa4\u0acd\u0ab0.'},auth:{login:'\u0ab2\u0acb\u0a97 \u0a87\u0aa8 \u0a95\u0ab0\u0acb'}},kn:{common:{appName:'\u0cad\u0cbe\u0cb0\u0ca4\u0ccd \u0caa\u0cb2\u0ccd\u0cb8\u0ccd\u200c\u0cb2\u0cbf\u0c82\u0c95\u0ccd',continue:'\u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf',back:'\u0cb9\u0cbf\u0c82\u0ca6\u0cc6',skip:'\u0ca4\u0ccd\u0caf\u0c9c\u0cbf\u0cb8\u0cbf',getStarted:'\u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf'},onboarding:{common:{continue:'\u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf',back:'\u0cb9\u0cbf\u0c82\u0ca6\u0cc6',skip:'\u0ca4\u0ccd\u0caf\u0c9c\u0cbf\u0cb8\u0cbf',getStarted:'\u0caa\u0ccd\u0cb0\u0cbe\u0cb0\u0c82\u0cad\u0cbf\u0cb8\u0cbf'},screen1:{eyebrow:'\u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cc1',title:'\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf. \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca8\u0cbf\u0cb0\u0c82\u0ca4\u0cb0\u0ca4\u0cc6.',description:'\u0ca8\u0cc0\u0cb5\u0cc1 \u0c8e\u0cb2\u0ccd\u0cb2\u0cc7 \u0c9a\u0cbf\u0c95\u0cbf\u0ca4\u0ccd\u0cb8\u0cc6 \u0caa\u0ca1\u0cc6\u0ca6\u0cb0\u0cc2 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0cb5\u0ca8\u0ccd\u0ca8\u0cc1 \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf\u0cb0\u0cbf\u0cb8\u0cbf.',accessibilityHero:'\u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf \u0c97\u0cc1\u0cb0\u0cc1\u0ca4\u0cbf\u0ca8 \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0.'},screen2:{eyebrow:'\u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0c95\u0ccd \u0cb2\u0cad\u0ccd\u0caf\u0ca4\u0cc6',title:'\u0cb8\u0cae\u0cc0\u0caa\u0ca6 \u0c86\u0cb0\u0cc8\u0c95\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c95\u0c82\u0ca1\u0cc1\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf.',description:'\u0cad\u0cbe\u0cb0\u0ca4\u0ca6\u0cbe\u0ca6\u0ccd\u0caf\u0c82\u0ca4 \u0c86\u0cb8\u0ccd\u0caa\u0ca4\u0ccd\u0cb0\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0caa\u0ccd\u0cb0\u0caf\u0ccb\u0c97\u0cbe\u0cb2\u0caf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0ca4\u0c95\u0ccd\u0cb7\u0ca3 \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbf.',accessibilityHero:'\u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf \u0ca8\u0cc6\u0c9f\u0ccd\u200c\u0cb5\u0cb0\u0ccd\u0c95\u0ccd \u0cb9\u0cc1\u0ca1\u0cc1\u0c95\u0cbe\u0c9f\u0ca6 \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0.'},screen3:{eyebrow:'\u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0ca4\u0cc6 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb8\u0cae\u0ccd\u0cae\u0ca4\u0cbf',title:'\u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4\u0cb5\u0cbe\u0c97\u0cbf \u0cb9\u0c82\u0c9a\u0cbf\u0c95\u0cca\u0cb3\u0ccd\u0cb3\u0cbf.',description:'\u0cb8\u0c82\u0caa\u0cc2\u0cb0\u0ccd\u0ca3 \u0c97\u0ccc\u0caa\u0ccd\u0caf\u0ca4\u0cc6 \u0ca8\u0cbf\u0caf\u0c82\u0ca4\u0ccd\u0cb0\u0ca3\u0ca6\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cbf\u0c97\u0cc6 \u0cb8\u0cc0\u0cae\u0cbf\u0ca4 \u0caa\u0ccd\u0cb0\u0cb5\u0cc7\u0cb6 \u0ca8\u0cc0\u0ca1\u0cbf.',accessibilityHero:'\u0cb8\u0cc1\u0cb0\u0c95\u0ccd\u0cb7\u0cbf\u0ca4 \u0cb8\u0cae\u0ccd\u0cae\u0ca4\u0cbf\u0caf \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0.'},screen4:{eyebrow:'\u0c8f\u0c95\u0cc0\u0c95\u0cc3\u0ca4 \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf',title:'\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3, \u0cb8\u0c82\u0caa\u0cb0\u0ccd\u0c95\u0cbf\u0ca4\u0c97\u0cca\u0c82\u0ca1\u0cbf\u0ca6\u0cc6.',description:'\u0ca6\u0cbe\u0c96\u0cb2\u0cc6\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0cb5\u0cb0\u0ca6\u0cbf\u0c97\u0cb3\u0ca8\u0ccd\u0ca8\u0cc1 \u0c92\u0c82\u0ca6\u0cc7 \u0cb8\u0ccd\u0ca5\u0cb3\u0ca6\u0cb2\u0ccd\u0cb2\u0cbf \u0cb8\u0cc1\u0cb2\u0cad\u0cb5\u0cbe\u0c97\u0cbf \u0c9c\u0ccb\u0ca1\u0cbf\u0cb8\u0cbf.',accessibilityHero:'\u0c8f\u0c95\u0cc0\u0c95\u0cc3\u0ca4 \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf \u0cb5\u0ccd\u0caf\u0cb5\u0cb8\u0ccd\u0ca5\u0cc6\u0caf \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0.'}},languageSelection:{eyebrow:'\u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0cad\u0cbe\u0cb7\u0cc6',title:'\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf',subtitle:'\u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0cb0\u0ccb\u0c97\u0ccd\u0caf \u0cb0\u0c95\u0ccd\u0cb7\u0ca3\u0cc6\u0caf \u0caa\u0ccd\u0cb0\u0caf\u0cbe\u0ca3\u0c95\u0ccd\u0c95\u0cbe\u0c97\u0cbf \u0ca8\u0cbf\u0cae\u0ccd\u0cae \u0c86\u0ca6\u0ccd\u0caf\u0ca4\u0cc6\u0caf \u0cad\u0cbe\u0cb7\u0cc6\u0caf\u0ca8\u0ccd\u0ca8\u0cc1 \u0c86\u0caf\u0ccd\u0c95\u0cc6\u0cae\u0cbe\u0ca1\u0cbf',continue:'\u0cae\u0cc1\u0c82\u0ca6\u0cc1\u0cb5\u0cb0\u0cbf\u0cb8\u0cbf',accessibilityHero:'\u0cad\u0cbe\u0cb7\u0cbe \u0c85\u0ca8\u0cc1\u0cb5\u0cbe\u0ca6\u0ca6 \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0.'},auth:{login:'\u0cb2\u0cbe\u0c97\u0cbf\u0ca8\u0ccd \u0cae\u0cbe\u0ca1\u0cbf'}},ml:{common:{appName:'\u0d2d\u0d3e\u0d30\u0d24\u0d4d \u0d2a\u0d7e\u0d38\u0d4d \u0d32\u0d3f\u0d19\u0d4d\u0d15\u0d4d',continue:'\u0d24\u0d41\u0d1f\u0d30\u0d41\u0d15',back:'\u0d2e\u0d1f\u0d19\u0d4d\u0d19\u0d41\u0d15',skip:'\u0d12\u0d34\u0d3f\u0d35\u0d3e\u0d15\u0d4d\u0d15\u0d41\u0d15',getStarted:'\u0d06\u0d30\u0d02\u0d2d\u0d3f\u0d15\u0d4d\u0d15\u0d41\u0d15'},onboarding:{common:{continue:'\u0d24\u0d41\u0d1f\u0d30\u0d41\u0d15',back:'\u