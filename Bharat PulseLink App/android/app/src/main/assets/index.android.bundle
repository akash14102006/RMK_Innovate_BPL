093e \u091a\u093f\u0924\u094d\u0930\u0964'},screen3:{eyebrow:'\u092e\u0930\u0940\u091c\u093c \u0915\u0940 \u0938\u0939\u092e\u0924\u093f \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e',title:'\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0938\u093e\u091d\u093e \u0915\u0930\u0947\u0902\u0964 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u092e\u0947\u0902 \u0930\u0939\u0947\u0902\u0964',description:'\u092a\u0942\u0930\u094d\u0923 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0915\u0947 \u0938\u093e\u0925 \u0905\u092a\u0928\u0947 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0924\u0915 \u0938\u0940\u092e\u093f\u0924 \u0938\u092e\u092f \u0915\u0947 \u0932\u093f\u090f \u092a\u0939\u0941\u0902\u091a \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0947\u0902\u0964',accessibilityHero:'\u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u0939\u092e\u0924\u093f \u0915\u093e \u091a\u093f\u0924\u094d\u0930\u0964'},screen4:{eyebrow:'\u090f\u0915\u0932 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u0947\u0935\u093e \u092f\u0941\u0917',title:'\u0906\u092a\u0915\u0940 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u092f\u093e\u0924\u094d\u0930\u093e, \u090f\u0915 \u0938\u093e\u0925 \u091c\u0941\u0921\u093c\u0940 \u0939\u0941\u0908\u0964',description:'\u090f\u0915 \u0939\u0940 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u0930\u093f\u0915\u0949\u0930\u094d\u0921, \u0928\u0941\u0938\u094d\u0916\u0947 \u0914\u0930 \u091c\u093e\u0902\u091a \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u094b \u0928\u093f\u0930\u094d\u092c\u093e\u0927 \u0930\u0942\u092a \u0938\u0947 \u091c\u094b\u0921\u093c\u0947\u0902\u0964',accessibilityHero:'\u090f\u0915\u0940\u0915\u0943\u0924 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0923\u093e\