# Bharat PulseLink Backend — Environment Template
# Copy to .env for local development. NEVER commit real secrets.
# Production secrets are managed via Secret Manager (Prompt 136).

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=debug
API_PREFIX=/api/v1
SHUTDOWN_TIMEOUT_MS=15000
REQUEST_BODY_LIMIT_BYTES=1048576

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (docker-compose.yml)
DATABASE_URL=postgresql://bpl_user:bpl_local_dev_only@localhost:5432/bharat_pulselink_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_ACQUIRE_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Test database (separate container — port 5433)
TEST_DATABASE_URL=postgresql://bpl_test_user:bpl_test_local_only@localhost:5433/bharat_pulselink_test

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local development (docker-compose.yml)
REDIS_URL=redis://:bpl_redis_local_dev_only@localhost:6379
REDIS_REQUIRED=false

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# ── Descope Authentication (Prompt 88) ───────────────────────────────────────
DESCOPE_PROJECT_ID=P3I9QWPyM9U9U4hEa9u5613xRwbf
# DESCOPE_MANAGEMENT_KEY=<your-management-key>

# ── MiniMoth WhatsApp OTP (Prompt 88) ────────────────────────────────────────
# MINIMOTH_API_KEY=<your-minimoth-api-key>

# ── Storage (Prompt 111) ──────────────────────────────────────────────────────
STORAGE_PROVIDER=local
# S3 example:
# STORAGE_PROVIDER=s3
# STORAGE_BUCKET=bharat-pulselink-dev
# STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# STORAGE_ACCESS_KEY=<access-key>
# STORAGE_SECRET_KEY=<secret-key>

# ── Notifications (Prompt 114) ────────────────────────────────────────────────
# FCM_SERVER_KEY=<firebase-server-key>
# SENDGRID_API_KEY=<sendgrid-key>
# TWILIO_ACCOUNT_SID=<twilio-sid>
# TWILIO_AUTH_TOKEN=<twilio-auth-token>

# ── Observability (Prompt 118) ────────────────────────────────────────────────
OTEL_SERVICE_NAME=bharat-pulselink-api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Government Integration (Prompts 95-97) ───────────────────────────────────
# GOVT_API_BASE_URL=https://facility.ndhm.gov.in/api/v1
# GOVT_API_KEY=<government-api-key>

# ── Blockchain / Integrity (Prompt 113) ──────────────────────────────────────
BLOCKCHAIN_PROVIDER=disabled
# BLOCKCHAIN_NODE_URL=https://polygon-mumbai.g.alchemy.com/v2/<key>
# BLOCKCHAIN_WALLET_KEY=<wallet-private-key>
