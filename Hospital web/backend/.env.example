# Environment Variables for Bharat PulseLink Backend

# Server Configuration
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# JWT Authentication Secret (CHANGE THIS IN PRODUCTION!)
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-in-production

# External API Keys (Global - Used for ALL users)
# Get your free WAQI key from: https://aqicn.org/data-platform/token/
WAQI_API_KEY=your-actual-waqi-api-key-from-aqicn-org

# Get your free OpenWeather key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-actual-openweather-api-key

# Get your free News API key from: https://newsapi.org/register
NEWS_API_KEY=your-actual-news-api-key-from-newsapi-org

# Get your free Calendarific key from: https://calendarific.com/signup
CALENDARIFIC_API_KEY=your-actual-calendarific-api-key

# Get your Google Maps API key from: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your-actual-google-maps-api-key

# Get your Google Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-actual-gemini-api-key

# Database (Optional - for persistent user storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/healthpulse
# Or use MongoDB: mongodb://localhost:27017/healthpulse

# ── Bharat PulseLink Interoperability Bridge ──────────────────────────────
BPL_INTEGRATION_BASE_URL=http://127.0.0.1:8085/api/v1
HOSPITAL_ID=hosp_smart_triage_01
FACILITY_ID=fac_emergency_01
BPL_SERVICE_KEY=bpl_service_key_dev

