  {
    "id": "TC007",
    "title": "Complete API setup successfully and proceed to dashboard",
    "description": "Verifies a user can configure all required API keys, see a success confirmation, and access the dashboard afterward.",
    "category": "API Setup",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Sign in\" or \"Log in\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/setup\""
      },
      {
        "type": "action",
        "description": "Click \"Configure API Keys\" button"
      },
      {
        "type": "action",
        "description": "Fill \"Gemini API Key\" with \"valid-gemini-key-123\""
      },
      {
        "type": "action",
        "description": "Fill \"Google Maps API Key\" with \"valid-maps-key-123\""
      },
      {
        "type": "action",
        "description": "Fill \"Weather API Key\" with \"valid-weather-key-123\""
      },
      {
        "type": "action",
        "description": "Click \"Save All Configuration\" button"
      },
      {
        "type": "assertion",
        "description": "Verify text \"Configuration saved\" is visible"
      },
      {
        "type": "action",
        "description": "Click on \"Dashboard\" in the main navigation"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/dashboard\""
      }
    ]
  },
